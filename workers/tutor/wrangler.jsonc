{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "curso-arte-tutor",
  "main": "src/index.ts",
  "account_id": "12f212a7c813ec3aef9e1d873e19f43e",
  "compatibility_date": "2026-05-28",
  "routes": [{ "pattern": "tutor.hilvan.org", "custom_domain": true }],
  // Proveedor del tutor. "groq" usa el modelo abierto de OpenAI (gpt-oss-120b),
  // barato y rápido; requiere el secret GROQ_API_KEY (`wrangler secret put
  // GROQ_API_KEY`). Cambia a "anthropic" para volver a Claude Sonnet 5 (con visión).
  "vars": {
    "TUTOR_PROVEEDOR": "groq",
    "GROQ_MODELO": "openai/gpt-oss-120b"
  },
  "ratelimits": [
    { "name": "TUTOR_RL", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "TUTOR_RL_GLOBAL", "namespace_id": "1002", "simple": { "limit": 200, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
